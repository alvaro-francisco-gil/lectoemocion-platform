{
  "name": "lectoemocion-platform",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "commands": "node scripts/help.mjs",
    "build": "turbo run build",
    "check": "pnpm guardrails && pnpm typecheck && pnpm test && pnpm build",
    "deploy:player": "firebase deploy --only hosting",
    "dev": "turbo run dev --filter=@lectoemocion/player-web",
    "mobile": "node scripts/mobile-emulator.mjs",
    "mobile:up": "node scripts/mobile-emulator.mjs up",
    "mobile:boot": "node scripts/mobile-emulator.mjs boot",
    "mobile:start": "node scripts/mobile-emulator.mjs start",
    "mobile:lan": "node scripts/mobile-emulator.mjs lan",
    "guardrails": "node scripts/check-engine-neutral.mjs && node scripts/check-firebase-boundary.mjs && node scripts/check-strict-types.mjs && node scripts/check-privacy.mjs && node scripts/check-progress-boundary.mjs && node scripts/check-child-namespace.mjs && node scripts/check-adult-gate.mjs",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @lectoemocion/player-web test:e2e",
    "typecheck": "turbo run typecheck",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "sharp": "^0.35.3",
    "turbo": "^2.10.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
