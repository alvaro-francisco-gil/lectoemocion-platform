# Where the embedded player is loaded from.
#
# In development this is the player's Vite dev server, reached over the local
# network — so it must be the machine's LAN address, never 127.0.0.1, which on a
# phone means the phone itself. Start that server with:
#
#   PLAYER_HOST=0.0.0.0 pnpm dev
#
# Copy this file to `.env` and set your own address. `hostname -I` prints it.
EXPO_PUBLIC_PLAYER_URL=http://192.168.1.42:4173
